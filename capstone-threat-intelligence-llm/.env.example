# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=threat_intelligence_db

# LLM Backend: "local_slm", "ollama", or "openai"
LLM_BACKEND=local_slm

# Ollama Configuration (if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Configuration (if LLM_BACKEND=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Vulnerability Bot Configuration
BOT_SCAN_INTERVAL=60

# FastAPI Backend Service URL
BACKEND_URL=http://localhost:8000
